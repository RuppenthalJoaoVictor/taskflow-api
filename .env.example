# Copie este arquivo para .env e ajuste os valores.
# NUNCA commite o .env com segredos reais.

# Banco de dados (SQLite por padrão; PostgreSQL em produção)
DATABASE_URL=sqlite:///./taskflow.db

# Chave usada para assinar os tokens JWT.
# Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave-em-producao

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

APP_NAME=TaskFlow API
APP_VERSION=0.1.0
DEBUG=False